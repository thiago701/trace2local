<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>tech.neural7.trace2local</groupId>
    <artifactId>trace2local-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>trace2local-mocks</artifactId>
  <name>Trace2Local — Mock Connect</name>
  <description>Plugins adaptadores de mock de API (ADR-016), no modelo do Kafka Connect: fontes de stub
    (OpenAPI, tráfego observado, inline/WireMock), transformações de resposta encadeáveis com predicados,
    destinos (servidor embutido, WireMock, exportação) e um conselheiro que sugere quando plugar um mock
    e quais variações de resposta validar.</description>

  <dependencies>
    <dependency>
      <groupId>tech.neural7.trace2local</groupId>
      <artifactId>trace2local-core</artifactId>
    </dependency>
    <dependency>
      <groupId>tech.neural7.trace2local</groupId>
      <artifactId>trace2local-otel</artifactId>
      <!-- só pelos NOMES de atributo (OtelAttributeNames/Trace2LocalAttributes, ADR-008) -->
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <!-- contratos OpenAPI em YAML (a maioria dos specs de parceiros) -->
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
