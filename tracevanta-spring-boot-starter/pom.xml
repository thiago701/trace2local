<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>tech.neural7.tracevanta</groupId>
    <artifactId>tracevanta-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tracevanta-spring-boot-starter</artifactId>
  <name>TraceVanta — Spring Boot starter</name>
  <description>Autoconfiguração do modo Embedded: boot do SDK OTel + SpanProcessor, catálogo de endpoints (RequestMappingHandlerMapping), Request Launcher com SSRF-guard, guarda de produção, banner e RuntimeHints (ADR-005).</description>

  <dependencies>
    <dependency>
      <groupId>tech.neural7.tracevanta</groupId>
      <artifactId>tracevanta-core</artifactId>
    </dependency>
    <dependency>
      <groupId>tech.neural7.tracevanta</groupId>
      <artifactId>tracevanta-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>tech.neural7.tracevanta</groupId>
      <artifactId>tracevanta-server</artifactId>
    </dependency>
    <dependency>
      <groupId>tech.neural7.tracevanta</groupId>
      <artifactId>tracevanta-ui</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- Boot 4 removeu spring-boot-starter-aop; o @TraceVanta usa spring-aop + aspectjweaver diretamente -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-aop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- Para anexar o processor ao SDK quando a app já usa o autoconfigure do OTel
         (TraceVantaOtelConfigurer via ServiceLoader — SPEC §4.5) -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-extension-autoconfigure-spi</artifactId>
    </dependency>
    <!-- Modo Companion detectado (ADR-002): exporta OTLP/HTTP para o Station -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
