<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>tech.neural7.trace2local</groupId>
    <artifactId>trace2local-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <groupId>tech.neural7.trace2local.examples</groupId>
  <artifactId>finance-pix</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Trace2Local — finance-pix (Pix + antifraude: Lambda Java 25, API Gateway, DynamoDB, RDS Postgres, SQS, SNS)</name>
  <description>Projeto de validação na stack alvo: 3 Lambdas Java 25 (JVM e nativo GraalVM) atrás do API Gateway
    (OpenAPI), DynamoDB, Postgres (RDS na AWS / container local), SQS, SNS e 5 APIs externas mockadas,
    infraestrutura em Terraform. NÃO faz parte do reactor padrão (exige JDK 25):
    JAVA_HOME=&lt;jdk25&gt; mvn -f examples/finance-pix/pom.xml package</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <bundle.finalName>finance-pix</bundle.finalName>
    <version.postgresql>42.7.8</version.postgresql>
  </properties>

  <dependencies>
    <dependency>
      <groupId>tech.neural7.trace2local</groupId>
      <artifactId>trace2local-lambda</artifactId>
    </dependency>
    <dependency>
      <groupId>tech.neural7.trace2local</groupId>
      <artifactId>trace2local-aws</artifactId>
    </dependency>
    <dependency>
      <groupId>tech.neural7.trace2local</groupId>
      <artifactId>trace2local-jdbc</artifactId>
    </dependency>
    <!-- runtime CUSTOM (provided.al2023): o loop da Runtime API é nosso, então a API de
         contexto vai NO pacote (na imagem java25 gerenciada da AWS seria provided) -->
    <dependency>
      <groupId>com.amazonaws</groupId>
      <artifactId>aws-lambda-java-core</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sqs</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sns</artifactId>
    </dependency>
    <!-- cliente HTTP leve e amigável ao native-image (sem Netty/Apache) -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-aws-sdk-2.2</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${version.postgresql}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>url-connection-client</artifactId>
        <version>${version.awssdk}</version>
      </dependency>
      <dependency>
        <groupId>com.amazonaws</groupId>
        <artifactId>aws-lambda-java-core</artifactId>
        <version>${version.aws-lambda-core}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <finalName>${bundle.finalName}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <forceCreation>true</forceCreation>
          <archive>
            <manifest>
              <mainClass>tech.neural7.trace2local.examples.pix.runtime.Bootstrap</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>tech.neural7.trace2local.examples.pix.runtime.Bootstrap</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
