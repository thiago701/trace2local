# tracevanta-station (modo Companion) — java -jar do módulo tracevanta-station
FROM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /build
COPY . .
RUN mvn -q -pl tracevanta-station -am -DskipTests package

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /build/tracevanta-station/target/tracevanta-station-0.1.0-SNAPSHOT.jar station.jar
EXPOSE 9876
ENTRYPOINT ["java", "-jar", "station.jar"]
